# 后端服务的共享镜像定义(FastAPI + uvicorn)。
#
# 由 compose 的 build.args 传参;各仓不再自带 Dockerfile。
#   PY_VERSION    Python 版本
#   APT_PACKAGES  额外系统包(留空则不装)
#   APP_MODULE    uvicorn 应用路径,例如 api:app
#   APP_PORT      容器内监听端口
#   GIT_COMMIT    构建时注入,运行时由 /version 暴露
ARG PY_VERSION=3.12
FROM python:${PY_VERSION}-slim

ARG APT_PACKAGES="git"
RUN if [ -n "$APT_PACKAGES" ]; then \
      apt-get update \
      && apt-get install -y --no-install-recommends $APT_PACKAGES \
      && rm -rf /var/lib/apt/lists/*; \
    fi

WORKDIR /app

# 依赖先装,便于分层缓存。
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r requirements.txt

COPY . .

# 日志目录,宿主机挂载到统一路径。
RUN mkdir -p /app/logs

ARG APP_MODULE
ARG APP_PORT=8000
ENV APP_MODULE=${APP_MODULE} APP_PORT=${APP_PORT}

# 构建时的 commit 放在最后,避免使上面的依赖层失效。
ARG GIT_COMMIT=dev
ENV APP_GIT_COMMIT=$GIT_COMMIT

EXPOSE ${APP_PORT}
ENTRYPOINT ["/app/.platform/entrypoint.sh"]
